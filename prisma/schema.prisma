datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRoleType {
  ADMINISTRADOR
  GERENTE
  VENDEDOR
  ESTOQUISTA
  PRODUCAO
  FINANCEIRO
}

enum CustomerType {
  PF
  PJ
}

enum AddressType {
  RESIDENCIAL
  COMERCIAL
  ENTREGA
  INSTALACAO
}

enum UnitOfMeasure {
  UN
  M
  M2
  KG
  L
  CX
  KIT
}

enum ProductKind {
  VIDRO_TEMPERADO
  VIDRO_LAMINADO
  VIDRO_COMUM
  ESPELHO
  PERFIL_ALUMINIO
  FERRAGEM
  ACESSORIO
  CONSUMIVEL
}

enum QuoteStatus {
  RASCUNHO
  EM_NEGOCIACAO
  ENVIADO
  APROVADO
  RECUSADO
  EXPIRADO
  CANCELADO
}

enum OrderStatus {
  AGUARDANDO_PRODUCAO
  EM_PRODUCAO
  PRONTO
  EM_INSTALACAO
  ENTREGUE
  CONCLUIDO
  CANCELADO
}

enum StockMovementType {
  ENTRADA
  SAIDA
  RESERVA
  CANCELAMENTO_RESERVA
  PERDA
  AVARIA
  AJUSTE
  DEVOLUCAO
}

enum MaterialLossReason {
  QUEBRA
  ERRO_CORTE
  AVARIA
  DEFEITO_FABRICANTE
  SOBRA_DESCARTE
  OUTROS
}

enum ProductionStage {
  MEDICAO
  PROJETO
  CORTE
  BENEFICIAMENTO
  MONTAGEM
  EXPEDICAO
  INSTALACAO
  CONCLUIDO
}

enum ProductionStepStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDO
  BLOQUEADO
}

enum ReceivableStatus {
  PENDENTE
  PAGO
  ATRASADO
  PARCIAL
  CANCELADO
}

enum CommissionStatus {
  PENDENTE
  LIBERADA
  PAGA
  CANCELADA
}

model User {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  passwordHash String       @map("password_hash")
  role         UserRoleType @default(VENDEDOR)
  maxDiscount  Decimal      @default(5.0) @db.Decimal(5, 2) @map("max_discount")
  isActive     Boolean      @default(true) @map("is_active")
  avatarUrl    String?      @map("avatar_url")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")

  quotes          Quote[]
  orders          Order[]
  stockMovements  StockMovement[]
  inventoryCounts InventoryCount[]
  measurements    Measurement[]
  productionSteps ProductionStep[]
  materialLosses  MaterialLoss[]
  auditLogs       AuditLog[]
  commissions     Commission[]
  priceHistories  PriceHistory[]

  @@map("users")
}

model Customer {
  id                String       @id @default(uuid())
  type              CustomerType @default(PF)
  name              String
  tradeName         String?      @map("trade_name")
  document          String       @unique
  stateRegistration String?      @map("state_registration")
  phone             String
  whatsapp          String
  secondaryPhone    String?      @map("secondary_phone")
  email             String?
  notes             String?
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  deletedAt         DateTime?    @map("deleted_at")

  addresses   CustomerAddress[]
  quotes      Quote[]
  orders      Order[]
  receivables Receivable[]

  @@map("customers")
}

model CustomerAddress {
  id           String      @id @default(uuid())
  customerId   String      @map("customer_id")
  type         AddressType @default(RESIDENCIAL)
  zipCode      String      @map("zip_code")
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  isDefault    Boolean     @default(false) @map("is_default")
  createdAt    DateTime    @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_addresses")
}

model Supplier {
  id          String    @id @default(uuid())
  tradeName   String    @map("trade_name")
  companyName String    @map("company_name")
  document    String    @unique
  contactName String?   @map("contact_name")
  phone       String
  whatsapp    String?
  email       String?
  address     String?
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  products Product[]

  @@map("suppliers")
}

model ProductCategory {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  products Product[]

  @@map("product_categories")
}

model Product {
  id            String        @id @default(uuid())
  internalCode  String        @unique @map("internal_code")
  sku           String?       @unique
  barcode       String?       @map("barcode")
  name          String
  description   String?
  categoryId    String        @map("category_id")
  supplierId    String?       @map("supplier_id")
  kind          ProductKind   @default(VIDRO_TEMPERADO)
  unit          UnitOfMeasure @default(M2)
  
  glassType     String?       @map("glass_type")
  thicknessMm   Decimal?      @db.Decimal(5, 2) @map("thickness_mm")
  color         String?
  treatment     String?
  
  costPrice     Decimal       @db.Decimal(12, 2) @map("cost_price")
  salePrice     Decimal       @db.Decimal(12, 2) @map("sale_price")
  minPrice      Decimal       @db.Decimal(12, 2) @map("min_price")
  marginPercent Decimal       @db.Decimal(5, 2) @map("margin_percent")
  
  minStockAlert Decimal       @default(0) @db.Decimal(12, 3) @map("min_stock_alert")
  maxStockLimit Decimal?      @db.Decimal(12, 3) @map("max_stock_limit")
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deletedAt     DateTime?     @map("deleted_at")

  category       ProductCategory @relation(fields: [categoryId], references: [id])
  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
  stock          Stock?
  stockMovements StockMovement[]
  priceHistories PriceHistory[]
  materialLosses MaterialLoss[]

  @@map("products")
}

model PriceHistory {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  oldPrice  Decimal  @db.Decimal(12, 2) @map("old_price")
  newPrice  Decimal  @db.Decimal(12, 2) @map("new_price")
  oldCost   Decimal? @db.Decimal(12, 2) @map("old_cost")
  newCost   Decimal? @db.Decimal(12, 2) @map("new_cost")
  userId    String   @map("user_id")
  reason    String
  changedAt DateTime @default(now()) @map("changed_at")

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@map("price_histories")
}

model Service {
  id          String        @id @default(uuid())
  code        String        @unique
  name        String
  description String?
  unit        UnitOfMeasure @default(UN)
  costPrice   Decimal       @db.Decimal(12, 2) @map("cost_price")
  salePrice   Decimal       @db.Decimal(12, 2) @map("sale_price")
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  @@map("services")
}

model PaymentMethod {
  id         String             @id @default(uuid())
  name       String
  code       String             @unique
  isActive   Boolean            @default(true) @map("is_active")
  conditions PaymentCondition[]
  payments   Payment[]

  @@map("payment_methods")
}

model PaymentCondition {
  id               String   @id @default(uuid())
  paymentMethodId  String   @map("payment_method_id")
  name             String
  installments     Int      @default(1)
  discountPercent  Decimal  @default(0) @db.Decimal(5, 2) @map("discount_percent")
  surchargePercent Decimal  @default(0) @db.Decimal(5, 2) @map("surcharge_percent")
  intervalDays     Int      @default(30) @map("interval_days")
  isActive         Boolean  @default(true) @map("is_active")

  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  quotes        Quote[]
  orders        Order[]

  @@map("payment_conditions")
}

model Quote {
  id                   String      @id @default(uuid())
  quoteNumber          String      @unique @map("quote_number")
  customerId           String      @map("customer_id")
  userId               String      @map("user_id")
  currentVersion       Int         @default(1) @map("current_version")
  status               QuoteStatus @default(RASCUNHO)
  
  issueDate            DateTime    @default(now()) @map("issue_date")
  validUntil           DateTime    @map("valid_until")
  expectedDeliveryDays Int?        @map("expected_delivery_days")
  
  deliveryAddress      String?     @map("delivery_address")
  installationAddress  String?     @map("installation_address")
  paymentConditionId   String?     @map("payment_condition_id")
  
  subtotalAmount       Decimal     @db.Decimal(12, 2) @map("subtotal_amount")
  discountPercent      Decimal     @default(0) @db.Decimal(5, 2) @map("discount_percent")
  discountAmount       Decimal     @default(0) @db.Decimal(12, 2) @map("discount_amount")
  surchargeAmount      Decimal     @default(0) @db.Decimal(12, 2) @map("surcharge_amount")
  freightAmount        Decimal     @default(0) @db.Decimal(12, 2) @map("freight_amount")
  totalAmount          Decimal     @db.Decimal(12, 2) @map("total_amount")
  
  notes                String?
  approvalNotes        String?     @map("approval_notes")
  approvedAt           DateTime?   @map("approved_at")
  approvedByUserId     String?     @map("approved_by_user_id")
  
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")
  deletedAt            DateTime?   @map("deleted_at")

  customer         Customer          @relation(fields: [customerId], references: [id])
  user             User              @relation(fields: [userId], references: [id])
  paymentCondition PaymentCondition? @relation(fields: [paymentConditionId], references: [id])
  versions         QuoteVersion[]
  order            Order?

  @@map("quotes")
}

model QuoteVersion {
  id              String   @id @default(uuid())
  quoteId         String   @map("quote_id")
  versionNumber   Int      @map("version_number")
  subtotalAmount  Decimal  @db.Decimal(12, 2) @map("subtotal_amount")
  discountAmount  Decimal  @db.Decimal(12, 2) @map("discount_amount")
  surchargeAmount Decimal  @db.Decimal(12, 2) @map("surcharge_amount")
  freightAmount   Decimal  @db.Decimal(12, 2) @map("freight_amount")
  totalAmount     Decimal  @db.Decimal(12, 2) @map("total_amount")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  quote Quote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  items QuoteItem[]

  @@unique([quoteId, versionNumber])
  @@map("quote_versions")
}

model QuoteItem {
  id               String        @id @default(uuid())
  quoteVersionId   String        @map("quote_version_id")
  itemOrder        Int           @map("item_order")
  itemType         String        @map("item_type")
  productId        String?       @map("product_id")
  serviceId        String?       @map("service_id")
  
  code             String
  description      String
  unit             UnitOfMeasure
  
  widthMm          Decimal?      @db.Decimal(8, 2) @map("width_mm")
  heightMm         Decimal?      @db.Decimal(8, 2) @map("height_mm")
  areaM2           Decimal?      @db.Decimal(8, 4) @map("area_m2")
  finishingDetails String?       @map("finishing_details")
  
  quantity         Decimal       @db.Decimal(10, 3)
  unitPrice        Decimal       @db.Decimal(12, 2) @map("unit_price")
  discountAmount   Decimal       @default(0) @db.Decimal(12, 2) @map("discount_amount")
  totalPrice       Decimal       @db.Decimal(12, 2) @map("total_price")

  quoteVersion QuoteVersion @relation(fields: [quoteVersionId], references: [id], onDelete: Cascade)

  @@map("quote_items")
}

model Order {
  id                   String      @id @default(uuid())
  orderNumber          String      @unique @map("order_number")
  quoteId              String      @unique @map("quote_id")
  approvedQuoteVer     Int         @map("approved_quote_ver")
  customerId           String      @map("customer_id")
  userId               String      @map("user_id")
  status               OrderStatus @default(AGUARDANDO_PRODUCAO)
  
  orderDate            DateTime    @default(now()) @map("order_date")
  promisedDeliveryDate DateTime?   @map("promised_delivery_date")
  actualDeliveryDate   DateTime?   @map("actual_delivery_date")
  
  deliveryAddress      String?     @map("delivery_address")
  installationAddress  String?     @map("installation_address")
  paymentConditionId   String?     @map("payment_condition_id")
  
  subtotalAmount       Decimal     @db.Decimal(12, 2) @map("subtotal_amount")
  discountAmount       Decimal     @db.Decimal(12, 2) @map("discount_amount")
  surchargeAmount      Decimal     @db.Decimal(12, 2) @map("surcharge_amount")
  freightAmount        Decimal     @db.Decimal(12, 2) @map("freight_amount")
  totalAmount          Decimal     @db.Decimal(12, 2) @map("total_amount")
  
  notes                String?
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")
  deletedAt            DateTime?   @map("deleted_at")

  quote             Quote             @relation(fields: [quoteId], references: [id])
  customer          Customer          @relation(fields: [customerId], references: [id])
  user              User              @relation(fields: [userId], references: [id])
  paymentCondition  PaymentCondition? @relation(fields: [paymentConditionId], references: [id])
  
  items             OrderItem[]
  productionOrder   ProductionOrder?
  stockReservations StockReservation[]
  stockMovements    StockMovement[]
  receivables       Receivable[]
  commissions       Commission[]

  @@map("orders")
}

model OrderItem {
  id               String        @id @default(uuid())
  orderId          String        @map("order_id")
  itemType         String        @map("item_type")
  productId        String?       @map("product_id")
  serviceId        String?       @map("service_id")
  code             String
  description      String
  unit             UnitOfMeasure
  widthMm          Decimal?      @db.Decimal(8, 2) @map("width_mm")
  heightMm         Decimal?      @db.Decimal(8, 2) @map("height_mm")
  areaM2           Decimal?      @db.Decimal(8, 4) @map("area_m2")
  finishingDetails String?       @map("finishing_details")
  quantity         Decimal       @db.Decimal(10, 3)
  unitPrice        Decimal       @db.Decimal(12, 2) @map("unit_price")
  discountAmount   Decimal       @db.Decimal(12, 2) @map("discount_amount")
  totalPrice       Decimal       @db.Decimal(12, 2) @map("total_price")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Stock {
  id             String   @id @default(uuid())
  productId      String   @unique @map("product_id")
  physicalStock  Decimal  @default(0) @db.Decimal(12, 3) @map("physical_stock")
  reservedStock  Decimal  @default(0) @db.Decimal(12, 3) @map("reserved_stock")
  availableStock Decimal  @default(0) @db.Decimal(12, 3) @map("available_stock")
  locationCode   String?  @map("location_code")
  updatedAt      DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("stocks")
}

model StockMovement {
  id               String            @id @default(uuid())
  productId        String            @map("product_id")
  type             StockMovementType
  quantity         Decimal           @db.Decimal(12, 3)
  previousPhysical Decimal           @db.Decimal(12, 3) @map("previous_physical")
  nextPhysical     Decimal           @db.Decimal(12, 3) @map("next_physical")
  previousReserved Decimal           @db.Decimal(12, 3) @map("previous_reserved")
  nextReserved     Decimal           @db.Decimal(12, 3) @map("next_reserved")
  orderId          String?           @map("order_id")
  reason           String
  userId           String            @map("user_id")
  createdAt        DateTime          @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])
  order   Order?  @relation(fields: [orderId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@map("stock_movements")
}

model StockReservation {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  productId   String   @map("product_id")
  quantity    Decimal  @db.Decimal(12, 3)
  isFulfilled Boolean  @default(false) @map("is_fulfilled")
  createdAt   DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("stock_reservations")
}

model InventoryCount {
  id        String               @id @default(uuid())
  countDate DateTime             @default(now()) @map("count_date")
  userId    String               @map("user_id")
  notes     String?
  status    String               @default("CONCLUIDO")
  items     InventoryCountItem[]

  user User @relation(fields: [userId], references: [id])

  @@map("inventory_counts")
}

model InventoryCountItem {
  id               String   @id @default(uuid())
  inventoryCountId String   @map("inventory_count_id")
  productId        String   @map("product_id")
  expectedQuantity Decimal  @db.Decimal(12, 3) @map("expected_quantity")
  countedQuantity  Decimal  @db.Decimal(12, 3) @map("counted_quantity")
  difference       Decimal  @db.Decimal(12, 3)
  adjustmentReason String   @map("adjustment_reason")

  inventoryCount InventoryCount @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)

  @@map("inventory_count_items")
}

model MaterialLoss {
  id                String             @id @default(uuid())
  productId         String             @map("product_id")
  quantity          Decimal            @db.Decimal(12, 3)
  reason            MaterialLossReason
  orderId           String?            @map("order_id")
  productionOrderId String?            @map("production_order_id")
  userId            String             @map("user_id")
  notes             String?
  createdAt         DateTime           @default(now()) @map("created_at")

  product         Product          @relation(fields: [productId], references: [id])
  order           Order?           @relation(fields: [orderId], references: [id])
  productionOrder ProductionOrder? @relation(fields: [productionOrderId], references: [id])
  user            User             @relation(fields: [userId], references: [id])

  @@map("material_losses")
}

model ProductionOrder {
  id             String          @id @default(uuid())
  orderId        String          @unique @map("order_id")
  currentStage   ProductionStage @default(MEDICAO) @map("current_stage")
  startDate      DateTime?       @map("start_date")
  completionDate DateTime?       @map("completion_date")
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  order        Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  steps        ProductionStep[]
  measurements Measurement[]
  losses       MaterialLoss[]

  @@map("production_orders")
}

model ProductionStep {
  id                String               @id @default(uuid())
  productionOrderId String               @map("production_order_id")
  stage             ProductionStage
  status            ProductionStepStatus @default(PENDENTE)
  assignedUserId    String?              @map("assigned_user_id")
  startedAt         DateTime?            @map("started_at")
  completedAt       DateTime?            @map("completed_at")
  notes             String?
  attachments       String[]

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  assignedUser    User?            @relation(fields: [assignedUserId], references: [id])

  @@map("production_steps")
}

model Measurement {
  id                String   @id @default(uuid())
  productionOrderId String   @map("production_order_id")
  environment       String
  widthMm           Decimal  @db.Decimal(8, 2) @map("width_mm")
  heightMm          Decimal  @db.Decimal(8, 2) @map("height_mm")
  depthMm           Decimal? @db.Decimal(8, 2) @map("depth_mm")
  thicknessMm       Decimal? @db.Decimal(5, 2) @map("thickness_mm")
  glassType         String?  @map("glass_type")
  color             String?
  notes             String?
  photos            String[]
  measuredByUserId  String   @map("measured_by_user_id")
  measuredAt        DateTime @default(now()) @map("measured_at")

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  measuredByUser  User            @relation(fields: [measuredByUserId], references: [id])

  @@map("measurements")
}

model Receivable {
  id                String           @id @default(uuid())
  orderId           String           @map("order_id")
  customerId        String           @map("customer_id")
  installmentNum    Int              @map("installment_num")
  totalInstallments Int              @map("total_installments")
  originalAmount    Decimal          @db.Decimal(12, 2) @map("original_amount")
  paidAmount        Decimal          @default(0) @db.Decimal(12, 2) @map("paid_amount")
  balanceDue        Decimal          @db.Decimal(12, 2) @map("balance_due")
  dueDate           DateTime         @map("due_date")
  status            ReceivableStatus @default(PENDENTE)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id])
  payments Payment[]

  @@map("receivables")
}

model Payment {
  id               String   @id @default(uuid())
  receivableId     String   @map("receivable_id")
  paymentMethodId  String   @map("payment_method_id")
  amountPaid       Decimal  @db.Decimal(12, 2) @map("amount_paid")
  penaltyAmount    Decimal  @default(0) @db.Decimal(12, 2) @map("penalty_amount")
  discountAmount   Decimal  @default(0) @db.Decimal(12, 2) @map("discount_amount")
  paymentDate      DateTime @default(now()) @map("payment_date")
  receiptDocUrl    String?  @map("receipt_doc_url")
  notes            String?
  recordedByUserId String   @map("recorded_by_user_id")

  receivable    Receivable    @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  @@map("payments")
}

model Commission {
  id               String           @id @default(uuid())
  userId           String           @map("user_id")
  orderId          String           @map("order_id")
  baseAmount       Decimal          @db.Decimal(12, 2) @map("base_amount")
  percent          Decimal          @db.Decimal(5, 2)
  commissionAmount Decimal          @db.Decimal(12, 2) @map("commission_amount")
  status           CommissionStatus @default(PENDENTE)
  paidAt           DateTime?        @map("paid_at")
  createdAt        DateTime         @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id])
  order Order @relation(fields: [orderId], references: [id])

  @@map("commissions")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@map("audit_logs")
}

model Notification {
  id        String        @id @default(uuid())
  userId    String?       @map("user_id")
  role      UserRoleType?
  title     String
  message   String
  linkUrl   String?       @map("link_url")
  isRead    Boolean       @default(false) @map("is_read")
  createdAt DateTime      @default(now()) @map("created_at")

  @@map("notifications")
}
